# ARES development configuration
ARES_ENV=development
ARES_LOG_LEVEL=INFO

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Database placeholder for a future phase
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/ares

# Ollama placeholder for a future phase
OLLAMA_BASE_URL=http://localhost:11434

# Execution limits for future sandbox work
EXECUTION_TIMEOUT_SECONDS=120
SANDBOX_NETWORK_DISABLED=true
